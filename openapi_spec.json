{
  "openapi": "3.1.0",
  "info": {
    "title": "PI-RADS v2.1 prostate MRI scoring reference",
    "version": "2.0.1",
    "description": "Illustrative route index for the scoring API. Canonical generated schema is available from a running FastAPI server at /openapi.json. No clinical or regulatory validation is claimed."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health and version",
        "responses": {
          "200": {
            "description": "Health metadata"
          }
        }
      }
    },
    "/api/score": {
      "post": {
        "summary": "Combine sequence scores for one PI-RADS lesion",
        "description": "Validated scores from a qualified reader; not an image-analysis or clinical decision endpoint.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "zone": {
                    "type": "string",
                    "enum": [
                      "peripheral",
                      "transition"
                    ]
                  },
                  "t2w_score": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "dwi_score": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "dce_positive": {
                    "type": "boolean"
                  },
                  "size_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "lesion_id": {
                    "type": "string",
                    "maxLength": 50
                  }
                },
                "required": [
                  "zone",
                  "t2w_score",
                  "dwi_score"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PI-RADS category combination result"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/assess": {
      "post": {
        "summary": "Assess multiple lesions (up to 25)",
        "responses": {
          "200": {
            "description": "Combined assessment with maximum PI-RADS category"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy deterministic threshold demonstration",
        "description": "Does not apply a validated PI-RADS clinical decision rule.",
        "responses": {
          "200": {
            "description": "Demonstration audit result"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Legacy local status/help query",
        "description": "Deterministic mock; no language model inference.",
        "responses": {
          "200": {
            "description": "Deterministic response"
          }
        }
      }
    }
  }
}
